{
  "manifest_version": 3,
  "name": "WiFi Odds for Flights",
  "version": "2.2.0",
  "description": "See your flight's odds of next-gen WiFi in your search results. Auto-sorts by odds (toggle off anytime). Unofficial.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://unitedstarlinktracker.com/*"
  ],
  "optional_host_permissions": [
    "https://www.alaskaair.com/*",
    "https://alaskaair.com/*",
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.united.com/*",
        "https://united.com/*",
        "https://app.navan.com/*"
      ],
      "js": [
        "airlines.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/jeremyinthebay/united-starlink-companion"
}
